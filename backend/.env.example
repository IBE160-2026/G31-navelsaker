# Kopier til backend/.env og endre ved behov. Alle variablene er valgfrie.
# Relative stier regnes ut fra arbeidsmappa, så bruk absolutte stier.

# Database. Standard: SQLite-fil i backend/data/rbe.db (regnet ut fra pakkens plassering).
# RBE_DATABASE_URL=sqlite:///C:/sti/til/rbe.db

# Fasitfila som seedes ved tom database. Standard: testdata/testfartoy-v1/input.json i repoet.
# RBE_FIXTURE_PATH=C:/sti/til/repo/testdata/testfartoy-v1/input.json

# Nøkkel for signering av sesjonscookien. Mangler den, lages en tilfeldig ved oppstart
# (med en advarsel i loggen), og sesjonene overlever da ikke en omstart.
# Lag en med: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# RBE_SESSION_SECRET=

# Demobrukeren. Kjent demopassord, står i README.
# RBE_DEMO_USERNAME=demo
# RBE_DEMO_PASSWORD=demo
